CREATE VIEW gold.weekly_virus_stats AS

WITH agg AS (

    SELECT
        yearweek,
        to_date(
            yearweek || '-1',
            'IYYY-"W"IW-ID'
        ) AS week_start_date,

        countryname,
        survtype,
        pathogen,

        SUM(value) FILTER (
            WHERE indicator = 'tests'
        ) AS tests_total,

        SUM(value) FILTER (
            WHERE indicator = 'detections'
        ) AS detections_total

    FROM silver.fact_respiratory_surveillance
    GROUP BY
        1,2,3,4,5
)

SELECT
    week_start_date,
    yearweek,

    countryname,
    survtype,
    pathogen,

    tests_total,
    detections_total

FROM agg;

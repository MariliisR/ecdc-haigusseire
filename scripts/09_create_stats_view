/* MÕTLEME veel, kas leiab kasutust */
CREATE VIEW gold.weekly_virus_stats AS

SELECT
    yearweek,
    countryname,
    survtype,
    pathogen,

    SUM(value) FILTER (
        WHERE indicator = 'tests'
    ) AS tests_total,

    SUM(value) FILTER (
        WHERE indicator = 'detections'
    ) AS detections_total,

    CASE
        WHEN
            SUM(value) FILTER (
                WHERE indicator = 'tests'
            ) IS NULL

            OR

            SUM(value) FILTER (
                WHERE indicator = 'tests'
            ) = 0                  -- 0 tähendab, ettestiti ja midagi ei leitud
        THEN NULL                  -- NULL tähendab, et ei saa arvutada

        ELSE
            (
                SUM(value) FILTER (
                    WHERE indicator = 'detections'
                )::numeric          -- et 1/2 võrduks 0,5 ja mitte 0
            )
            /
            (
                SUM(value) FILTER (
                    WHERE indicator = 'tests'
                )
            )

    END AS positivity_rate          -- ehk meie 2. ja 3. mõõdik

FROM silver.fact_respiratory_surveillance

GROUP BY
    yearweek,
    countryname,
    survtype,
    pathogen;

CREATE OR REPLACE VIEW gold.weekly_virus_stats AS

WITH agg AS (

    SELECT
        yearweek || '-1',        -- nt 2026-W01-1 = 2026 ISO aasta nädal 1 esmaspäev
        'IYYY-"W"IW-ID'          -- IYYY = ISO aasta
                                 -- "W"  = literal täht W
                                 -- IW   = ISO nädal
                                 -- ID   = ISO nädalapäev (1 = esmaspäev)
    ) AS week_start_date,         -- vajalik Superseti jaoks, et oleks päris DATE tüüpi ajaväli

        countryname,              -- riik
        survtype,                 -- seiretüüp (sentinel, non-sentinel jne)
        pathogen,                 -- viirusetüüp (Influenza, RSV, SARS-CoV-2)

        SUM(value) FILTER (
            WHERE indicator = 'tests'
        ) AS tests_total,         -- nädalas tehtud testide koguarv

        SUM(value) FILTER (
            WHERE indicator = 'detections'
        ) AS detections_total     -- nädalas tuvastatud positiivsete proovide koguarv

    FROM silver.fact_respiratory_surveillance
    GROUP BY
        1,2,3,4,5                 -- üks rida iga:
                                  -- nädala
                                  -- riigi
                                  -- seiretüübi
                                  -- viirusetüübi
                                  -- kombinatsiooni kohta
)

SELECT
    week_start_date,
    yearweek,

    countryname,
    survtype,
    pathogen,

    tests_total,
    detections_total

FROM agg;
